# PostgreSQL connection string. Local example below; for Supabase use the
# connection string from Project Settings → Database (session pooler, port 5432).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bestiarium
# Set to "false" when using Supabase's transaction pooler (port 6543).
DATABASE_PREPARE=true
DATABASE_POOL_MAX=10

# Public site URL (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Separate database used by integration tests. It is wiped by the test run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/bestiarium_test

# Comma-separated hostnames allowed for externally hosted images (IIIF, museum CDNs).
# Images from any other host are not rendered.
IMAGE_HOST_ALLOWLIST=iiif.bodleian.ox.ac.uk,iiif.bl.uk,www.e-codices.unifr.ch,gallica.bnf.fr,media.getty.edu,images.metmuseum.org,upload.wikimedia.org,www.abdn.ac.uk
